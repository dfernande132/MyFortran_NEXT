{
  "files.eol": "\n",
  "files.encoding": "utf8",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.rulers": [80],
  "files.associations": {
    "*.f": "fortran-modern",
    "*.for": "fortran-modern",
    "*.f77": "fortran-modern"
  },
  "C_Cpp.default.configurationProvider": "",
  "C_Cpp.errorSquiggles": "enabled"
}
